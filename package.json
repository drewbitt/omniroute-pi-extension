{
  "name": "omniroute-pi-extension",
  "version": "0.1.0",
  "description": "OmniRoute custom provider extension for Pi.",
  "private": true,
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-extension",
    "omniroute"
  ],
  "type": "module",
  "scripts": {
    "check:syntax": "node --check index.ts && node --check tests/*.test.ts",
    "check": "npm run check:syntax && npm test",
    "test": "node --test tests/*.test.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "^0.83.0",
    "@earendil-works/pi-coding-agent": "^0.83.0"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.83.0",
    "@earendil-works/pi-coding-agent": "^0.83.0"
  }
}
