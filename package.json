{
  "name": "omniroute-pi-extension",
  "version": "0.3.2",
  "description": "Native OmniRoute provider extension for Pi with live model discovery.",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-extension",
    "omniroute"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "check:syntax": "node --check index.ts && node --check src/*.ts && node --check tests/*.test.ts",
    "check": "npm run typecheck && npm run lint && npm run check:syntax && npm test",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@earendil-works/pi-ai": "^0.84.2",
    "@earendil-works/pi-coding-agent": "^0.84.2",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drewbitt/omniroute-pi-extension.git"
  },
  "homepage": "https://github.com/drewbitt/omniroute-pi-extension#readme",
  "bugs": {
    "url": "https://github.com/drewbitt/omniroute-pi-extension/issues"
  }
}
